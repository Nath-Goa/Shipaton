# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real keys.

# Build identity. EAS sets this per profile: "judge" creates the GitHub-
# distributed Markva Judge APK, "production" is reserved for store builds,
# and an unset value is treated as local development.
EXPO_PUBLIC_APP_VARIANT=development

# RevenueCat public SDK keys (Project settings > API keys in the RevenueCat
# dashboard — one per app, per platform). These are safe to ship in the
# client bundle, but still come from env vars so dev/staging/prod RevenueCat
# projects can use different keys without touching code.
#
# Without these set, the app runs in local demo mode: the paywall shows a
# dev-only tier switcher instead of real store purchases.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Cross-platform fallback used when a project has not split its iOS/Android
# keys yet. Judge builds ignore it and use the Test Store key.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# RevenueCat Test Store key, used ONLY by the EAS "judge" profile. Test
# Store purchases exercise the real CustomerInfo/entitlement flow without
# opening Google Play billing or charging money. Put the real value in the
# EAS preview environment (and optionally local .env), never in git.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=

# --- RevenueCat dashboard setup this app expects -----------------------
# Entitlements (Project > Entitlements):
#   pro    — grants the Pro tier
#   max    — grants the Max tier (Max also gets Pro-level features)
#   stock_market_predictor_and_tutor — optional umbrella "any paid access"
#     entitlement; if present it's treated the same as "pro". Grant it on
#     every paid product if you'd rather use one entitlement instead of
#     per-tier ones — either setup works with no code changes.
#
# Offerings (Project > Offerings) — one per paid tier, identifier must match
# the tier name exactly:
#   "pro" offering  — monthly, annual, and lifetime packages
#   "max" offering  — monthly, annual, and lifetime packages
# Each package's attached product grants that offering's tier entitlement
# (and "max"'s packages should also grant "pro"-level features, or just use
# the "max" entitlement to imply Pro — see tierFromCustomerInfo in
# services/purchases/revenuecat.ts).
#
# Paywalls (Project > Paywalls) — optional; design one per offering in the
# dashboard, or leave unset and RevenueCat's default template is used
# automatically (see RevenueCatUI.presentPaywall in
# services/purchases/paywallUI.ts).
#
# Customer Center (Project > Customer Center) — optional; configure it in
# the dashboard to customize the self-serve management screen users reach
# from Settings > Upgrade > "Manage subscription". Works with defaults if
# left unconfigured.
# -------------------------------------------------------------------------

# Optional shared/fallback AI key (Gemini). When set, every AI feature
# (Assistant chat, receipt auto-fill, pattern detection) works out of the box
# for users who haven't pasted in their own API key, using this key instead —
# rate-limited across every install that falls back to it. Users who add
# their own key in Settings always get that instead (faster, no shared
# limits). Get a free key in minutes, no billing setup required, from
# https://aistudio.google.com/apikey
#
# Without this set, AI features simply require the user to add their own key
# (the original BYOK-only behavior).
EXPO_PUBLIC_SHARED_GEMINI_API_KEY=

# Optional SECOND shared/fallback key (OpenRouter — openrouter.ai, free
# account, no billing setup required to generate a key). When set alongside
# the Gemini key above, every text-based AI feature (chat, quizzes,
# challenges, pattern detection, spending insights — NOT receipt photo
# extraction, which always uses Gemini) races both providers and uses
# whichever answers successfully first — see services/ai/client.ts. Always
# pinned to a live-verified $0 ":free"-suffixed OpenRouter model
# (services/ai/openRouterModels.ts re-checks OpenRouter's own pricing data
# at runtime, so this can never drift onto a paid model even as their free
# lineup changes) — never a user's chosen chat model.
#
# Without this set, only the Gemini key above is used (unaffected).
EXPO_PUBLIC_SHARED_OPENROUTER_API_KEY=

# Optional real-market-data key (Twelve Data — twelvedata.com, free tier: 8
# req/min, 800 credits/day). When set, Markets/Portfolio/Home/Backtest show
# real live-ish prices and real historical daily bars instead of the fully
# local mock random-walk engine — see services/marketData/marketData.ts,
# which dispatches to services/marketData/liveMarketData.ts when this is
# set, or services/marketData/mockMarketData.ts (the original, still fully
# functional demo mode) when it's empty. Every fetch is TTL-gated (6h for
# daily bars, 60s for quotes) and falls back to cached or mock data on any
# failure, so a rate limit or bad key degrades gracefully rather than
# breaking the screen.
EXPO_PUBLIC_TWELVEDATA_API_KEY=

# Sentry DSN for crash/error reporting (Settings > Projects > Client Keys in
# the Sentry dashboard — a free account covers this). Public by design, safe
# to ship in the client bundle. Without it set, crash reporting is a no-op —
# the app behaves exactly as if @sentry/react-native weren't installed.
#
# metro.config.js and the "@sentry/react-native/expo" plugin in app.json are
# both already wired up for this and work fine with no DSN. The plugin's
# source-map auto-upload is turned off (disableAutoUpload: true in app.json)
# since it needs a SENTRY_AUTH_TOKEN we don't have — without that flag, a
# release build fails outright at the "Run gradlew" step instead of just
# skipping the upload. Once you set SENTRY_ORG/SENTRY_PROJECT in the plugin
# config and add a SENTRY_AUTH_TOKEN as an EAS secret (never in this file),
# remove disableAutoUpload to get readable native stack traces — see
# https://docs.sentry.io/platforms/react-native/guides/expo/
EXPO_PUBLIC_SENTRY_DSN=

# Supabase project (supabase.com — free tier). Powers accounts, email
# verification, families, friends, and duels (services/social/*,
# store/useAuthStore.ts). The anon/publishable key is safe to ship in the
# client bundle by design — Row Level Security policies on each table are
# the real access control, not secrecy of this key. NEVER put the
# secret/service_role key here or anywhere in this app; that one bypasses
# RLS entirely and must never leave the Supabase dashboard/server code.
#
# Get both from Settings > API Keys in the Supabase dashboard: Project URL,
# and the "Publishable key" under Publishable and secret API keys.
#
# Without these set, Phase 2 social features are unavailable — everything
# else in the app is unaffected.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
