# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real keys.

# RevenueCat public SDK keys (Project settings > API keys in the RevenueCat
# dashboard — one per app, per platform). These are safe to ship in the
# client bundle, but still come from env vars so dev/staging/prod RevenueCat
# projects can use different keys without touching code.
#
# Without these set, the app runs in local demo mode: the paywall shows a
# dev-only tier switcher instead of real store purchases.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
